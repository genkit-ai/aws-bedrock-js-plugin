{
  "name": "genkitx-aws-bedrock",
  "description": "Genkit AI framework plugin for AWS Bedrock APIs.",
  "keywords": [
    "genkit",
    "genkit-plugin",
    "genkit-model",
    "aws",
    "aws-bedrock",
    "ai",
    "genai",
    "generative-ai",
    "gen-ai"
  ],
  "version": "1.0.0",
  "type": "commonjs",
  "main": "lib/index.js",
  "module": "./lib/index.mjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/genkit-ai/aws-bedrock-js-plugin.git"
  },
  "author": "Xavier Portilla Edo",
  "license": "Apache-2.0",
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.941.0"
  },
  "peerDependencies": {
    "genkit": "^1.28.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.0",
    "@types/aws-lambda": "^8.10.160",
    "@types/node": "^26.0.0",
    "eslint": "^10.0.2",
    "genkit": "^1.44.0",
    "globals": "^17.0.0",
    "prettier": "^3.3.3",
    "prettier-plugin-organize-imports": "^4.3.0",
    "rimraf": "^6.0.1",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typedoc": "^0.28.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.2.0"
  },
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "require": "./lib/index.js",
      "import": "./lib/index.mjs",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib"
  ],
  "publishConfig": {
    "provenance": true,
    "access": "public"
  },
  "scripts": {
    "check": "tsc",
    "compile": "tsup-node",
    "build:clean": "rimraf ./lib",
    "build": "npm run build:clean && npm run check && npm run compile",
    "build:watch": "tsup-node --watch",
    "test": "tsx --test tests/*_test.ts",
    "test:file": "tsx --test",
    "test:live": "tsx --test tests/live_test.ts",
    "prepack": "npm run build",
    "format": "prettier --write 'src/**/*.ts' 'tests/**/*.ts' tsup.config.ts",
    "format:check": "prettier --check 'src/**/*.ts' 'tests/**/*.ts' tsup.config.ts",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint src/ tests/ --fix",
    "docs": "typedoc ./src/index.ts --out ./docs --tsconfig ./tsconfig.json"
  },
  "overrides": {
    "glob": "^14.0.2",
    "minimatch": "^11.0.1",
    "uuid": "^11.1.1"
  }
}
